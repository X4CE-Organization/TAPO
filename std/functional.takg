# functional: small functional helpers.
# Import with:  import "std/functional.takg" as F

fn identity(x) => x

fn always(value) => fn() => value

fn noop() => nil

# compose(f, g)(x) == f(g(x)); the rightmost function runs first.
fn compose(...functions) {
  fn(x) {
    var value = x
    var i = functions.size - 1
    while i >= 0 {
      value = functions[i](value)
      i -= 1
    }
    value
  }
}

# pipeline(f, g)(x) == g(f(x)); the leftmost function runs first.
fn pipeline(...functions) {
  fn(x) {
    var value = x
    for f in functions { value = f(value) }
    value
  }
}

fn curry2(f) => fn(a) => fn(b) => f(a, b)

fn curry3(f) => fn(a) => fn(b) => fn(c) => f(a, b, c)

# Call fn at most once; later calls return the first result.
fn once(f) {
  var called = false
  var saved = nil
  fn(...args) {
    if not called {
      saved = f(...args)
      called = true
    }
    saved
  }
}

# Memoise by the inspected argument list. Good for pure functions with simple
# arguments; complex keys are intentionally compared structurally.
fn memoize(f) {
  let cache = {}
  fn(...args) {
    let key = inspect(args)
    if cache.has_key?(key) { return cache[key] }
    let value = f(...args)
    cache[key] = value
    value
  }
}

# Run fn, retrying on a raised error. Returns the first successful value.
fn retry(f, attempts = 3) {
  if attempts < 1 { raise ArgumentError("attempts must be at least 1") }
  var last = nil
  var i = 0
  while i < attempts {
    try {
      return f()
    } catch err {
      last = err
      i += 1
    }
  }
  raise last
}

fn times(n, f) {
  let out = []
  var i = 0
  while i < n {
    out.push(f(i))
    i += 1
  }
  out
}

fn clamp(value, low, high) {
  if value < low { return low }
  if value > high { return high }
  value
}

fn between?(value, low, high) => value >= low and value <= high

fn sign(value) {
  if value > 0 { return 1 }
  if value < 0 { return -1 }
  0
}

fn sum(values) {
  var total = 0
  for value in values { total += value }
  total
}

fn average(values) {
  if values.empty? { return nil }
  sum(values) / values.size
}

fn tap(value, f) {
  f(value)
  value
}

fn attempt(f) {
  try {
    [true, f()]
  } catch err {
    [false, err]
  }
}
