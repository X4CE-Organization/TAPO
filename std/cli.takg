# Small command-line argument parser.
#
#   let args = cli.parse(argv, ["output", "o"])
#   args["flags"]        # map of boolean flags
#   args["options"]      # map of option values
#   args["positionals"]  # list of positional arguments

fn parse(argv, value_options = []) {
  let flags = {}
  let options = {}
  let positionals = []
  var i = 0
  var stop = false
  while i < argv.size {
    let arg = argv[i]
    if stop {
      positionals.push(arg)
    } else if arg == "--" {
      stop = true
    } else if arg.starts_with("--") {
      let body = arg.slice(2, arg.size - 2)
      if body.contains("=") {
        let eq = body.index_of("=")
        options[body.slice(0, eq)] = body.slice(eq + 1, body.size - eq - 1)
      } else if value_options.contains(body) and i + 1 < argv.size {
        options[body] = argv[i + 1]
        i += 1
      } else {
        flags[body] = true
      }
    } else if arg.starts_with("-") and arg.size > 1 {
      let body = arg.slice(1, arg.size - 1)
      if value_options.contains(body) and i + 1 < argv.size {
        options[body] = argv[i + 1]
        i += 1
      } else {
        flags[body] = true
      }
    } else {
      positionals.push(arg)
    }
    i += 1
  }
  {"flags": flags, "options": options, "positionals": positionals}
}

fn flag?(parsed, name) => parsed["flags"].has_key?(name) and parsed["flags"][name]

fn option(parsed, name, default = nil) {
  if parsed["options"].has_key?(name) { parsed["options"][name] } else { default }
}

fn positionals(parsed) => parsed["positionals"]

fn usage(program, lines) {
  println("Usage: #{program}")
  for line in lines { println("  " + line) }
}
