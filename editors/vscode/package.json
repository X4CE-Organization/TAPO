{
  "name": "tapo-language",
  "displayName": "TAPO",
  "description": "Syntax highlighting, snippets and language configuration for the TAPO programming language",
  "version": "0.0.3",
  "publisher": "x4ce",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "tapo",
    "language",
    "oop",
    "aspects"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tapo",
        "aliases": [
          "TAPO",
          "tapo"
        ],
        "extensions": [
          ".tapo",
          ".takg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tapo",
        "scopeName": "source.tapo",
        "path": "./syntaxes/tapo.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tapo",
        "path": "./snippets/tapo.json"
      }
    ]
  }
}
