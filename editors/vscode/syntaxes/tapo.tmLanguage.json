{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TAPO",
  "scopeName": "source.tapo",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.tapo",
          "begin": "#=",
          "end": "=#",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "name": "comment.line.number-sign.tapo",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.tapo",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.tapo",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.triple.single.tapo",
          "begin": "'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.double.tapo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.tapo",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.tapo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.tapo",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.tapo",
      "begin": "#\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "source.tapo"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.tapo",
          "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.tapo",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.class.tapo",
          "match": "\\b(class)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.tapo"
            },
            "2": {
              "name": "entity.name.type.class.tapo"
            }
          }
        },
        {
          "name": "meta.mixin.tapo",
          "match": "\\b(mixin)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.mixin.tapo"
            },
            "2": {
              "name": "entity.name.type.mixin.tapo"
            }
          }
        },
        {
          "name": "meta.aspect.tapo",
          "match": "\\b(aspect)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.aspect.tapo"
            },
            "2": {
              "name": "entity.name.type.aspect.tapo"
            }
          }
        },
        {
          "name": "meta.function.tapo",
          "match": "\\b(fn)\\s+([\\p{L}_][\\p{L}\\p{N}_]*[?!]?|[+\\-*/%<>=!&|^~]+)",
          "captures": {
            "1": {
              "name": "storage.type.function.tapo"
            },
            "2": {
              "name": "entity.name.function.tapo"
            }
          }
        },
        {
          "name": "meta.function.call.tapo",
          "match": "([\\p{L}_][\\p{L}\\p{N}_]*[?!]?)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.tapo"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tapo",
          "match": "\\b(if|else|elif|unless|while|until|for|in|loop|break|continue|return|match|try|catch|finally|raise)\\b"
        },
        {
          "name": "keyword.other.tapo",
          "match": "\\b(class|mixin|aspect|enum|fn|let|var|import|export|as|with|use|static|get|set|self|super|before|after|around|yield|and|or|not|is)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.tapo",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.class.tapo",
          "match": "\\b(Object|Int|Float|String|Bool|List|Map|Range|Nil|Function|Class|Module|Aspect|Mixin|Error|RuntimeError|ArgumentError|TypeError|NameError|AttributeError|IndexError|KeyError|ValueError|ZeroDivisionError|AssertionError|ImportError|IOError|MatchError|NotImplementedError|FrozenError)\\b"
        },
        {
          "name": "support.function.tapo",
          "match": "\\b(print|println|puts|p|input|len|str|int|float|bool|list|type|type_name|inspect|assert|assert_eq|assert_ne|assert_raises|test|panic|exit|sleep|clock|range|enumerate|zip|sum|min|max|sorted)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tapo",
          "match": "\\|>|\\?\\?=|\\?\\?|\\?\\.|\\.\\.\\.|\\.\\.|==|!=|<=|>=|<<=|>>=|\\*\\*=|//=|&&|\\|\\||\\+=|-=|\\*=|/=|%=|\\*\\*|//|<<|>>|=>|->|[+\\-*/%<>=!&|^~]=?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.tapo",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.tapo",
          "match": "\\."
        },
        {
          "name": "punctuation.section.tapo",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
