# New 0.0.2 libraries: encoding, UUID, INI, sets and templates.

import "std/base64.takg" as B
import "std/uuid.takg" as U
import "std/ini.takg" as I
import "std/set.takg" as S
import "std/template.takg" as T

println(B.encode("TAPO 你好"))
println(B.decode("VEFQTyDkvaDlpb0="))

let id = U.new()
println("uuid valid: #{U.valid?(id)}")

let config = I.parse("[app]\nname = TAPO\nversion = 0.0.2\n")
println(config["app"]["name"])

let values = S.new([1, 2, 2, 3])
println(values.union(S.new([3, 4])).to_list())

println(T.render("Hello {{name}} from {{project}}", {
  name: "Ada",
    project: "TAPO"
}))
