# Pipes and collection helpers.
import "std/collections.takg" as C

let numbers = 1..20

let answer = numbers
  |> _.filter(fn(n) => n % 3 == 0)
  |> _.map(fn(n) => n * n)
  |> _.sum()

println("sum of squares divisible by 3: #{answer}")
println("chunks: #{C.chunk(numbers.to_list(), 5)}")
println("frequencies: #{C.frequencies(["a", "b", "a"])}")

let total = 5 |> (fn(x) => x * 2)
println("pipe into lambda: #{total}")
