import "std/test.takg" as T

class Animal {
  var name = "?"
  init(name) { self.name = name }
  fn speak() => "..."
  fn describe() => "#{self.name} says #{self.speak()}"
}

class Dog < Animal {
  var breed = "mutt"
  init(name, breed = "mutt") {
    super.init(name)
    self.breed = breed
  }
  fn speak() => "woof"
}

mixin Greeter {
  fn greet() => "hi from #{self.name}"
}

class Person with Greeter {
  var name = "?"
  init(name) { self.name = name }
}

class Counter {
  var n = 0
  get value { self.n }
  set value(v) { self.n = v }
  fn bump() { self.n += 1; self }
  static fn make() => Counter()
}

class Vec {
  var x = 0, y = 0
  init(x, y) { self.x = x; self.y = y }
  fn +(other) => Vec(self.x + other.x, self.y + other.y)
  fn -(other) => Vec(self.x - other.x, self.y - other.y)
  fn ==(other) => self.x == other.x and self.y == other.y
  fn to_s() => "Vec(#{self.x}, #{self.y})"
}

class Box {
  var items = []
  fn get(i) => self.items[i]
  fn set(i, v) { self.items[i] = v }
}

class Ghost {
  fn method_missing(name, args) => "missing #{name} #{args}"
}

test("classes and inheritance", fn() {
  let d = Dog("Rex", "lab")
  assert_eq(d.name, "Rex")
  assert_eq(d.breed, "lab")
  assert_eq(d.speak(), "woof")
  assert_eq(d.describe(), "Rex says woof")
  assert(d.is_a?(Dog))
  assert(d.is_a?(Animal))
  assert(d.instance_of?(Dog))
  assert(not d.instance_of?(Animal))
})

test("mixins", fn() {
  let p = Person("Ada")
  assert_eq(p.greet(), "hi from Ada")
  assert(p.responds_to?("greet"))
})

test("getters, setters and statics", fn() {
  let c = Counter.make()
  c.value = 10
  c.bump()
  assert_eq(c.value, 11)
  assert(c.responds_to?("bump"))
})

test("operator overloading", fn() {
  let a = Vec(1, 2)
  let b = Vec(3, 4)
  assert_eq(a + b, Vec(4, 6))
  assert_eq(a - b, Vec(-2, -2))
  assert(a != b)
  assert_eq((a + b).to_s(), "Vec(4, 6)")
})

test("index protocol", fn() {
  let box = Box()
  box.items = [10, 20]
  assert_eq(box[0], 10)
  box[0] = 99
  assert_eq(box[0], 99)
  assert_eq(box.get(1), 20)
})

test("method_missing", fn() {
  let g = Ghost()
  assert_eq(g.boo(1, 2), "missing boo [1, 2]")
})

test("field-only construction", fn() {
  class Point { var x = 0, y = 0 }
  assert_eq(Point(2, 3).x, 2)
  assert_eq(Point(2, 3).y, 3)
})

test("unqualified self access", fn() {
  class Selfish {
    var value = 42
    fn get_value() => value
    fn helper() => "helped"
    fn call_helper() => helper()
  }
  let s = Selfish()
  assert_eq(s.get_value(), 42)
  assert_eq(s.call_helper(), "helped")
})

test("getter expression form", fn() {
  class Temp {
    var celsius = 0
    get fahrenheit => self.celsius * 9 // 5 + 32
    set celsius(v) { self.celsius = v }
  }
  let t = Temp()
  t.celsius = 100
  assert_eq(t.fahrenheit, 212)
})
