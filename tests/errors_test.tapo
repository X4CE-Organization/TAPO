import "std/test.takg" as T

class MyError < Error {}

test("try catch finally", fn() {
  var events = []
  let result = try {
    events.push("try")
    raise ValueError("bad")
  } catch e {
    events.push("catch:#{e.message}")
    "recovered"
  } finally {
    events.push("finally")
  }
  assert_eq(result, "recovered")
  assert_eq(events, ["try", "catch:bad", "finally"])
})

test("catch by error class", fn() {
  let message = try {
    raise TypeError("wrong")
  } catch TypeError {
    "caught type"
  }
  assert_eq(message, "caught type")
})

test("error hierarchy", fn() {
  var e = nil
  try { {}["missing"] } catch caught { e = caught }
  assert(e.is_a?(KeyError))
  assert(e.is_a?(Error))
  assert_eq(e.message, 'key "missing" not found')
})

test("custom error subclass", fn() {
  assert_raises(MyError, fn() { raise MyError("custom") })
  var e = nil
  try { raise MyError("custom") } catch caught { e = caught }
  assert_eq(e.class, MyError)
  assert_eq(e.message, "custom")
})

test("nested finally and return", fn() {
  var order = []
  fn run() {
    try {
      order.push(1)
      return "done"
    } finally {
      order.push(2)
    }
  }
  assert_eq(run(), "done")
  assert_eq(order, [1, 2])
})

test("assertions report nicely", fn() {
  assert_raises(AssertionError, fn() { assert_eq(1, 2, "numbers differ") })
  assert_raises(AssertionError, fn() { assert(false) })
  assert_raises(AssertionError, fn() { assert_raises(ValueError, fn() { 1 + 1 }) })
})
